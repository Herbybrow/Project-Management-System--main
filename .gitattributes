* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# The SPA is packaged separately from frontend/dist. Excluding its source from
# a committed backend release archive avoids transferring development-only UI
# files to the Laravel/PHP-FPM host.
frontend export-ignore
frontend/** export-ignore
