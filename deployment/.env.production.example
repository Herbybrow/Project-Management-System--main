APP_NAME="NSSF Project Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://147.182.164.148:8001
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=site2_db
DB_USERNAME=site2_user
DB_PASSWORD="<SET_MANUALLY>"
DB_SSLMODE=prefer

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_COOKIE=nssf_site2_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
CACHE_PREFIX=nssf_site2_cache
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

SANCTUM_TOKEN_EXPIRATION=720
CORS_ALLOWED_ORIGINS=http://147.182.164.148:8080

# Configure your real mail transport before enabling email delivery.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
